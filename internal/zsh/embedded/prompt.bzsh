# ------------------------------------------------------------------------------
# 󰅶 Busy Shell (bzsh) Prompt 
# ------------------------------------------------------------------------------
# Enable parameter/command expansion & load Zsh datetime/hook modules
setopt PROMPT_SUBST
zmodload zsh/datetime
autoload -Uz add-zsh-hook

# ------------------------------------------------------------------------------
# 1. Execution Timer & Newline Hooks
# ------------------------------------------------------------------------------
_prompt_preexec() {
  _CMD_START_TIME=$EPOCHREALTIME
  _SHOW_NEWLINE=1
}

_prompt_precmd() {
  # Add a line break after running a command (skipped on fresh shell startup)
  if [[ -n "$_SHOW_NEWLINE" ]]; then
    echo ""
    unset _SHOW_NEWLINE
  fi

  # Calculate command execution duration
  _CMD_ELAPSED=""
  if [[ -n "$_CMD_START_TIME" ]]; then
    local delta=$(( EPOCHREALTIME - _CMD_START_TIME ))
    unset _CMD_START_TIME

    if (( delta >= 60.0 )); then
      # Strip decimal places via ${delta%.*} for native integer arithmetic
      local total_sec=${delta%.*}
      local mins=$(( total_sec / 60 ))
      local secs=$(( total_sec % 60 ))
      _CMD_ELAPSED=" %F{yellow}took ${mins}m${secs}s%f"
    elif (( delta >= 1.0 )); then
      local sec_fmt
      printf -v sec_fmt "%.1f" $delta
      _CMD_ELAPSED=" %F{yellow}took ${sec_fmt}s%f"
    elif (( delta >= 0.1 )); then
      local ms_fmt
      printf -v ms_fmt "%.0f" $(( delta * 1000 ))
      _CMD_ELAPSED=" %F{yellow}took ${ms_fmt}ms%f"
    fi
  fi
}

add-zsh-hook preexec _prompt_preexec
add-zsh-hook precmd _prompt_precmd

# ------------------------------------------------------------------------------
# 2. Context Detectors (OS, Git & SDK)
# ------------------------------------------------------------------------------
_os_info() {
  if [[ -f /etc/os-release ]]; then
    local os_id
    os_id=$(grep -i '^ID=' /etc/os-release | cut -d= -f2 | tr -d '"')
    local os_like
    os_like=$(grep -i '^ID_LIKE=' /etc/os-release | cut -d= -f2 | tr -d '"')

    if [[ "$BZSH_NERD_FONTS" == "1" ]]; then
      if [[ "$os_id" == *"arch"* || "$os_like" == *"arch"* ]]; then
        echo "%F{cyan}󰣇 %f"
        return
      elif [[ "$os_id" == *"debian"* || "$os_id" == *"ubuntu"* || "$os_id" == *"pop"* || "$os_id" == *"mint"* || "$os_like" == *"debian"* || "$os_like" == *"ubuntu"* ]]; then
        echo "%F{red} %f"
        return
      fi
      echo "%F{green}🐧%f"
      return
    else
      if [[ "$os_id" == *"arch"* || "$os_like" == *"arch"* ]]; then
        echo "%F{cyan}[ARCH]%f"
        return
      elif [[ "$os_id" == *"debian"* || "$os_id" == *"ubuntu"* || "$os_id" == *"pop"* || "$os_id" == *"mint"* || "$os_like" == *"debian"* || "$os_like" == *"ubuntu"* ]]; then
        echo "%F{red}[DEB]%f"
        return
      fi
      echo "%F{green}[LINUX]%f"
      return
    fi
  fi

  if [[ "$BZSH_NERD_FONTS" == "1" ]]; then
    echo "%F{green}🐧%f"
  else
    echo "%F{green}[LINUX]%f"
  fi
}

_git_status() {
  local branch
  branch=$(git branch --show-current 2>/dev/null)
  [[ -z "$branch" ]] && branch=$(git rev-parse --short HEAD 2>/dev/null)
  [[ -z "$branch" ]] && return

  local dirty=""
  if [[ -n $(git status --porcelain 2>/dev/null | head -n 1) ]]; then
    dirty="*"
  fi

  if [[ "$BZSH_NERD_FONTS" == "1" ]]; then
    echo " %F{magenta} ${branch}${dirty}%f"
  else
    echo " %F{magenta}+${branch}${dirty}%f"
  fi
}

_sdk_info() {
  if [[ -f go.mod ]]; then
    local go_ver=""
    if command -v go &>/dev/null; then
      go_ver=$(go version 2>/dev/null | awk '{print $3}' | sed 's/^go//')
    else
      go_ver=$(awk '/^go / {print $2}' go.mod 2>/dev/null)
    fi
    if [[ "$BZSH_NERD_FONTS" == "1" ]]; then
      echo " %F{cyan} v${go_ver:-1}%f"
    else
      echo " %F{cyan}[Go v${go_ver:-1}]%f"
    fi

  elif [[ -f pyproject.toml || -f uv.lock || -f requirements.txt ]]; then
    local py_ver=""
    if command -v python3 &>/dev/null; then
      py_ver=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null)
    fi
    if [[ "$BZSH_NERD_FONTS" == "1" ]]; then
      echo " %F{yellow} v${py_ver:-3}%f"
    else
      echo " %F{yellow}[Py v${py_ver:-3}]%f"
    fi

  elif [[ -f Cargo.toml ]]; then
    local rust_ver=""
    if command -v rustc &>/dev/null; then
      rust_ver=$(rustc --version 2>/dev/null | awk '{print $2}')
    fi
    if [[ "$BZSH_NERD_FONTS" == "1" ]]; then
      echo " %F{red} v${rust_ver:-1}%f"
    else
      echo " %F{red}[Rust v${rust_ver:-1}]%f"
    fi

  elif [[ -f package.json ]]; then
    local node_ver=""
    if command -v node &>/dev/null; then
      node_ver=$(node -v 2>/dev/null | sed 's/^v//')
    fi
    if [[ "$BZSH_NERD_FONTS" == "1" ]]; then
      echo " %F{green} v${node_ver:-18}%f"
    else
      echo " %F{green}[Node v${node_ver:-18}]%f"
    fi

  elif [[ -f sdkconfig ]]; then
    if [[ "$BZSH_NERD_FONTS" == "1" ]]; then
      echo " %F{blue} ESP-IDF%f"
    else
      echo " %F{blue}[ESP-IDF]%f"
    fi

  elif [[ -f CMakeLists.txt || -f Makefile || -f makefile || -f GNUmakefile || -f platformio.ini || -f meson.build ]]; then
    local lang="C/C++"
    local icon=""
    local cpp_match=(*.(cpp|cxx|cc|hpp)(N[1]))
    local c_match=(*.(c|h)(N[1]))
    if (( ${#cpp_match} > 0 )); then
      lang="C++"
      icon=""
    elif (( ${#c_match} > 0 )); then
      lang="C"
      icon=""
    elif [[ -f CMakeLists.txt ]]; then
      lang="CMake"
      icon=""
    fi

    if [[ "$BZSH_NERD_FONTS" == "1" ]]; then
      echo " %F{blue}${icon} ${lang}%f"
    else
      echo " %F{blue}[${lang}]%f"
    fi

  elif [[ -f Containerfile || -f Dockerfile || -f compose.yaml || -f docker-compose.yml ]]; then
    if [[ "$BZSH_NERD_FONTS" == "1" ]]; then
      echo " %F{blue}󰡨 Docker%f"
    else
      echo " %F{blue}[Docker]%f"
    fi
  fi
}

_venv_info() {
  if [[ -n "$VIRTUAL_ENV" ]]; then
    echo "%F{yellow}(${VIRTUAL_ENV:t})%f "
  elif [[ -n "$CONDA_DEFAULT_ENV" ]]; then
    echo "%F{yellow}(${CONDA_DEFAULT_ENV})%f "
  fi
}

# ------------------------------------------------------------------------------
# 3. Prompt Assembly
# ------------------------------------------------------------------------------
PROMPT='$(_os_info) %F{blue}%~%f$(_git_status)$(_sdk_info)${_CMD_ELAPSED}
$(_venv_info)%F{green}%n@%m%f%# '



